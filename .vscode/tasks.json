{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open Altium part folder (Explorer)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\Open-AltiumPartFolder.ps1",
        "-PartNumber",
        "${input:altiumPartNumber}"
      ],
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
